# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git)

# จาก LINE Developers Console > ชื่อ Channel > แท็บ Messaging API
LINE_CHANNEL_ACCESS_TOKEN=

# จาก LINE Developers Console > ชื่อ Channel > แท็บ Basic settings
LINE_CHANNEL_SECRET=

# จาก data.tmd.go.th หลังสมัครสมาชิก (ถ้ายังไม่มี ปล่อยว่างไว้ก่อน ระบบจะใช้ข้อมูลจำลอง)
TMD_API_KEY=

# จังหวัดที่จะเช็คพยากรณ์อากาศ (ใช้เป็นค่ากลาง ถ้า user คนนั้นยังไม่มีโปรไฟล์ของตัวเอง)
TMD_PROVINCE=นครพนม

# userId ของแอดมิน (คนเดียวที่สั่ง /users กับ /setuser ได้)
# วิธีหา: เพิ่มเพื่อน OA ตัวเองก่อน แล้วดู log ตอน follow ในหน้า Render (Logs)
# จะเห็นบรรทัด "เพิ่มผู้ใช้ใหม่: <ชื่อ> (<userId>)" — เอา userId ตรงนั้นมาใส่
ADMIN_LINE_USER_ID=

# ช่วงเวลาก่อนกรีดยางที่ถือว่า "ใกล้ถึงเวลา" พอจะเช็ค/แจ้งเตือน (หน่วยนาที ปล่อยว่างได้ใช้ค่า default 60/120)
ALERT_LEAD_MIN_MINUTES=60
ALERT_LEAD_MAX_MINUTES=120

# พอร์ตที่ให้เซิร์ฟเวอร์รัน (Render จะกำหนดให้เองผ่าน env นี้อัตโนมัติ ไม่ต้องแก้)
PORT=3000
